      "name": "drawer.html",
      "dir": "templates/components",
      "content": "<div\n    x-data=\"{ show: false }\"\n    @open-drawer.window=\"if ($event.detail.id === '{{ id }}') show = true\"\n    @close-drawer.window=\"if ($event.detail.id === '{{ id }}') show = false\"\n    class=\"relative z-50\"\n>\n    <template x-teleport=\"body\">\n        <div\n            x-show=\"show\"\n            class=\"fixed inset-0 z-50 flex items-end justify-center\"\n            x-cloak\n        >\n            <!-- Overlay -->\n            <div\n                x-show=\"show\"\n                x-transition:enter=\"ease-out duration-300\"\n                x-transition:enter-start=\"opacity-0\"\n                x-transition:enter-end=\"opacity-100\"\n                x-transition:leave=\"ease-in duration-200\"\n                x-transition:leave-start=\"opacity-100\"\n                x-transition:leave-end=\"opacity-0\"\n                @click=\"show = false\"\n                class=\"fixed inset-0 bg-background/80 backdrop-blur-sm\"\n            ></div>\n\n            <!-- Content -->\n            <div\n                x-show=\"show\"\n                x-transition:enter=\"transition ease-in-out duration-300 transform\"\n                x-transition:enter-start=\"translate-y-full\"\n                x-transition:enter-end=\"translate-y-0\"\n                x-transition:leave=\"transition ease-in-out duration-300 transform\"\n                x-transition:leave-start=\"translate-y-0\"\n                x-transition:leave-end=\"translate-y-full\"\n                class=\"relative w-full max-w-lg rounded-t-xl border bg-background p-6 shadow-lg\"\n            >\n                <div class=\"mx-auto mb-8 h-1.5 w-12 rounded-full bg-muted\"></div>\n\n                <div class=\"flex flex-col space-y-1.5 text-center sm:text-left\">\n                    <h2 class=\"text-lg font-semibold leading-none tracking-tight\">{{ title }}</h2>\n                    {% if description %}\n                    <p class=\"text-sm text-muted-foreground\">{{ description }}</p>\n                    {% endif %}\n                </div>\n\n                <div class=\"py-4\">\n                    {{ slot|safe }}\n                </div>\n\n                {% if footer %}\n                <div class=\"flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2\">\n                    {{ footer|safe }}\n                </div>\n                {% endif %}\n            </div>\n        </div>\n    </template>\n</div>\n"
    },
    {
      "name": "drawer.py",
      "dir": "templatetags",
      "content": "from django import template\nfrom django.utils.html import escape\nfrom django.utils.safestring import mark_safe\n\nregister = template.Library()\n\ndef format_html_attrs(attrs):\n    attr_list = []\n    for key, attr_value in attrs.items():\n        attr_list.append(f'{key.replace(\"_\", \"-\")}=\"{escape(str(attr_value))}\"')\n    return mark_safe(\" \".join(attr_list))\n\n@register.inclusion_tag('components/drawer.html')\ndef djinn_drawer(class_name=\"\", **attrs):\n    \"\"\"\n    Djinn Drawer component tag.\n    \"\"\"\n    return {\n        \"class\": class_name,\n        \"attrs\": format_html_attrs(attrs),\n    }\n"
    }
  ],
